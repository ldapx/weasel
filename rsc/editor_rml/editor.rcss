/* Weasel editor (RmlUi) theme — matches the ImGui editor palette:
   olive primary @olive, gold secondary @gold, near-black backgrounds
   @bg-root / #0c0d12 / @bg-deep, warm off-white text @text.
   Layout stays absolute-positioned: every element participating in layout
   sets its display explicitly. */

body
{
	/* ---- theme palette (@token = value). Ui expands these when
	   serving editor.rcss; see source_file_interface. ---- */
	/* @text = #f2ebe9 */
	/* @bright = #ffffff */
	/* @dim = #9a938b */
	/* @muted = #8f8a80 */
	/* @faint = #6b655a */
	/* @faint-alt = #6e6a63 */
	/* @bg-root = #09090c */
	/* @bg-panel = #0c0d12f7 */
	/* @bg-toolbar = #0c0d12f5 */
	/* @bg-deep = #101116 */
	/* @bg-input = #101218 */
	/* @bg-card = #14161ee6 */
	/* @bg-well = #06070ad9 */
	/* @bg-row = #1b1d26 */
	/* @bg-hover = #262a37 */
	/* @bg-tab-hover = #2c3242 */
	/* @bg-menu-hover = #2b3040 */
	/* @border = #2a2c38 */
	/* @border-strong = #2f3242 */
	/* @border-faint = #23252f */
	/* @olive = #68763c */
	/* @olive-light = #8fa34f */
	/* @gold = #dec16b */
	/* @gold-light = #e8d194 */
	/* @gold-hover = #dec16b1c */
	/* @gold-target = #dec16b30 */
	/* @gold-selected = #dec16b40 */
	/* @gold-selected-hover = #dec16b59 */
	/* @zebra-even = #ffffff06 */
	/* @red = #e06c60 */
	/* @amber = #f9e2af */
	/* @green-bright = #a6e3a1 */
	/* @error-dark = #7c3a3a */
	/* @error-border = #a05050 */
	/* @role-blue = #66b3ff */
	/* @role-green = #99e699 */
	/* @role-yellow = #cccc66 */
	/* @sep = #4a4438 */
	/* @card = rgb(14, 15, 20) */
	/* @backdrop = #0000008c */
	/* @veil = #07080bf2 */
	/* @scrollbar-track = #09090c80 */
	display: block;
	width: 100%;
	height: 100%;
	margin: 0px;
	padding: 0px;
	font-family: "Spline Sans";
	font-size: 13px;
	color: @text;
}

/* ================================================================ scrollbars */

scrollbarvertical
{
	width: 5px;
}

scrollbarvertical slidertrack
{
	background-color: @scrollbar-track;
}

scrollbarvertical sliderbar
{
	background-color: @border-strong;
	min-height: 12px;
	border-radius: 3px;
}

scrollbarvertical sliderbar:hover
{
	background-color: @olive;
}

scrollbarhorizontal
{
	height: 5px;
}

scrollbarhorizontal slidertrack
{
	background-color: @scrollbar-track;
}

scrollbarhorizontal sliderbar
{
	background-color: @border-strong;
	min-width: 12px;
	border-radius: 3px;
}

scrollbarhorizontal sliderbar:hover
{
	background-color: @olive;
}

/* ================================================================ menu bar */

#menubar
{
	position: absolute;
	left: 0px;
	right: 0px;
	top: 0px;
	height: 30px;
	margin: 0px;
	background-color: @bg-root;
	border-bottom-width: 1px;
	border-bottom-color: @border;
	z-index: 10;
}

.mb-item
{
	position: absolute;
	top: 0px;
	height: 30px;
	margin: 0px;
}

#mb-file { left: 4px; width: 52px; }
#mb-scene { left: 56px; width: 66px; }
#mb-window { left: 122px; width: 78px; }

.menubtn
{
	display: block;
	width: 100%;
	height: 28px;
	line-height: 28px;
	box-sizing: border-box;
	margin: 0px;
	padding: 0px 10px;
	text-align: left;
	background-color: transparent;
	border-width: 0px;
	color: @text;
	font-size: 13px;
}

.menubtn:hover
{
	background-color: @bg-hover;
}

.menu
{
	position: absolute;
	left: 0px;
	top: 29px;
	width: 220px;
	display: none;
	margin: 0px;
	background-color: @bg-deep;
	border-width: 1px;
	border-color: @border-strong;
	border-radius: 4px;
	padding: 4px 0px;
	z-index: 11;
}

.menu.shown
{
	display: block;
}

.menuitem
{
	display: block;
	margin: 0px;
	padding: 5px 12px;
	cursor: pointer;
	color: @text;
}

.menuitem:hover
{
	background-color: @bg-menu-hover;
	color: @bright;
}

.menusep
{
	display: block;
	height: 1px;
	margin: 4px 8px;
	padding: 0px;
	background-color: @border;
}

/* =============================================================== status bar */

#statusbar
{
	position: absolute;
	left: 0px;
	right: 0px;
	bottom: 0px;
	height: 22px;
	margin: 0px;
	background-color: @bg-root;
	border-top-width: 1px;
	border-top-color: @border;
	z-index: 5;
}

#status
{
	position: absolute;
	left: 12px;
	right: 12px;
	top: 4px;
	color: @dim;
	font-size: 12px;
	text-align: left;
}

.mode
{
	display: inline-block;
	margin: 0px;
	padding: 1px 8px;
	border-radius: 4px;
	font-weight: bold;
	font-size: 11px;
}

.mode-edit
{
	background-color: @olive;
	color: @text;
}

.mode-playing
{
	background-color: @gold;
	color: @bg-root;
}

.mode-paused
{
	background-color: transparent;
	border-width: 1px;
	border-color: @gold;
	color: @gold;
}

.st-dim
{
	color: @dim;
}

.st-sep
{
	color: @sep;
	margin: 0px 6px;
}

/* ================================================================== panels */

.panel
{
	display: block;
	margin: 0px;
	padding: 0px;
	background-color: @bg-panel;
	border-width: 1px;
	border-color: @border;
}

#left
{
	position: absolute;
	left: 0px;
	top: 30px;
	width: 22%;
	bottom: 22px;
}

#right
{
	position: absolute;
	right: 0px;
	top: 30px;
	width: 25%;
	bottom: 22px;
}

#bottom
{
	position: absolute;
	left: 22%;
	right: 25%;
	bottom: 22px;
	height: 27%;
}

.panel.hidden,
#bottom.hidden
{
	display: none;
}

.panel-title
{
	position: absolute;
	left: 7px;
	top: 6px;
	display: block;
	margin: 0px;
	padding: 0px;
	color: @dim;
	font-size: 12px;
}

/* ================================================================ tabs */

.tabbar
{
	position: absolute;
	left: 0px;
	right: 0px;
	top: 0px;
	height: 28px;
	display: flex;
	margin: 0px;
	background-color: @bg-deep;
	border-bottom-width: 1px;
	border-bottom-color: @border;
}

/* Tabs fill the whole tab-bar height: the visible strip is exactly the
   clickable/hoverable area. The active tab gets a gold underline. */
.tab
{
	display: inline-block;
	box-sizing: border-box;
	height: 28px;
	line-height: 17px;
	margin: 0px 1px 0px 0px;
	padding: 5px 14px 3px 14px;
	color: @dim;
	font-size: 12px;
	background-color: transparent;
	border-bottom-width: 2px;
	border-bottom-color: transparent;
	cursor: pointer;
}

.tab.active
{
	color: @text;
	border-bottom-color: @gold;
}

/* Hover rules come after '.tab.active' on purpose: equal specificity means
   the later rule wins, so the active tab highlight reacts to the pointer too. */
.tab:hover
{
	color: @bright;
	background-color: @bg-tab-hover;
}

.tab.active:hover
{
	color: @bright;
	background-color: @bg-tab-hover;
}

.tabpage
{
	position: absolute;
	left: 0px;
	right: 0px;
	top: 29px;
	bottom: 0px;
	display: block;
	margin: 0px;
}

.tabpage.hidden
{
	display: none;
}

#hierarchy
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 4px;
	bottom: 38%;
	display: block;
	margin: 0px;
}

#singletons-title
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 62%;
	height: 20px;
	display: block;
	margin: 4px 0px 0px 0px;
	padding: 0px 6px;
	color: @dim;
	font-size: 12px;
	font-weight: bold;
}

#singletons
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 62%;
	bottom: 6px;
	display: block;
	margin: 26px 0px 0px 0px;
}

#inspector
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 4px;
	bottom: 6px;
	display: block;
	margin: 0px;
}

#files-toolbar
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 4px;
	height: 26px;
	display: block;
	margin: 0px;
	padding: 0px;
}

#files
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 34px;
	bottom: 6px;
	display: block;
	margin: 0px;
}

#build-actions
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 4px;
	display: block;
	margin: 0px;
	padding: 0px;
}

#build-actions button
{
	margin-right: 4px;
	margin-bottom: 4px;
}

#build-lists
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 62px;
	bottom: 6px;
	display: block;
	margin: 0px;
}

#systems
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 4px;
	bottom: 6px;
	display: block;
	margin: 0px;
}

#console-output
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 4px;
	bottom: 34px;
	display: block;
	margin: 0px;
	background-color: @bg-well;
	border-width: 1px;
	border-color: @border-faint;
	border-radius: 4px;
	padding: 4px 6px;
}

#console-input-wrap
{
	position: absolute;
	left: 6px;
	right: 6px;
	bottom: 6px;
	height: 24px;
	display: block;
	margin: 0px;
	padding: 0px;
}

#console-input
{
	display: block;
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	margin: 0px;
	background-color: @bg-input;
	border-width: 1px;
	border-color: @border-strong;
	border-radius: 4px;
	color: @text;
	padding: 1px 6px;
	font-size: 13px;
}

#console-input:focus
{
	border-color: @olive-light;
}

#log-filters
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 4px;
	height: 24px;
	display: block;
	margin: 0px;
	padding: 0px;
}

#log-filters button
{
	margin-right: 4px;
	padding: 2px 8px;
	vertical-align: middle;
}

.lvbtn
{
	min-width: 26px;
	text-align: center;
}

.lvbtn.active
{
	background-color: @olive;
	border-color: @olive-light;
	color: @text;
	font-weight: bold;
}

.lvsep
{
	display: inline-block;
	width: 1px;
	height: 16px;
	margin: 0px 6px;
	padding: 0px;
	vertical-align: middle;
	background-color: @border;
}

#log-category
{
	display: inline-block;
	box-sizing: border-box;
	height: 22px;
	margin: 0px;
	padding: 1px 4px;
	vertical-align: middle;
	background-color: @bg-input;
	border-width: 1px;
	border-color: @border-strong;
	border-radius: 4px;
	color: @text;
	font-size: 12px;
}

#log-output
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 34px;
	bottom: 6px;
	display: block;
	margin: 0px;
	background-color: @bg-well;
	border-width: 1px;
	border-color: @border-faint;
	border-radius: 4px;
	padding: 4px 6px;
}

/* ============================================================== game view */

#gameview-toolbar
{
	position: absolute;
	left: 22%;
	right: 25%;
	top: 30px;
	height: 36px;
	display: block;
	margin: 0px;
	padding-top: 5px;
	padding-right: 0px;
	padding-bottom: 0px;
	padding-left: 0px;
	text-align: center;
	background-color: @bg-toolbar;
	border-width: 1px;
	border-color: @border;
}

.tgroup
{
	display: inline-block;
	margin: 0px;
	padding: 0px;
	vertical-align: middle;
}

.tgroup button
{
	margin-right: 2px;
	margin-left: 2px;
}

.tsep
{
	display: inline-block;
	width: 1px;
	height: 18px;
	margin: 0px 8px;
	padding: 0px;
	vertical-align: middle;
	background-color: @border;
}

#gameview
{
	position: absolute;
	left: 22%;
	right: 25%;
	top: 66px;
	bottom: 27%;
	display: block;
	margin: 0px;
	border-width: 1px;
	border-color: @border;
}

/* ================================================================ buttons */

button
{
	display: inline-block;
	box-sizing: border-box;
	margin: 0px;
	padding: 4px 10px;
	background-color: @bg-row;
	border-width: 1px;
	border-color: @border-strong;
	border-radius: 4px;
	color: @text;
	font-size: 12px;
	cursor: pointer;
}

button:hover
{
	background-color: @bg-hover;
}

button.active
{
	background-color: @olive;
	border-color: @olive-light;
	color: @text;
	font-weight: bold;
}

button:disabled
{
	opacity: 0.5;
	cursor: default;
}

.btn--primary
{
	background-color: @gold;
	border-color: @gold;
	color: @bg-root;
	font-weight: bold;
}

.btn--primary:hover
{
	background-color: @gold-light;
	border-color: @gold-light;
}

.btn--secondary
{
	background-color: transparent;
	border-color: @border-strong;
	color: @text;
}

.btn--secondary:hover
{
	background-color: @bg-row;
}

.btn--success
{
	background-color: @olive;
	border-color: @olive-light;
	color: @text;
	font-weight: bold;
}

.btn--error
{
	background-color: @error-dark;
	border-color: @error-border;
	color: @text;
	font-weight: bold;
}

.gap
{
	display: inline-block;
	width: 14px;
	height: 1px;
}

/* =============================================================== inputs */

input
{
	display: inline-block;
	box-sizing: border-box;
	margin: 0px;
	padding: 2px 6px;
	background-color: @bg-input;
	border-width: 1px;
	border-color: @border-strong;
	border-radius: 4px;
	color: @text;
	font-size: 13px;
}

input:focus
{
	border-color: @olive-light;
}

/* ======================================================= resize handles */

.handle-v
{
	position: absolute;
	display: block;
	top: 30px;
	bottom: 22px;
	width: 8px;
	margin-left: -4px;
	background-color: transparent;
}

.handle-h
{
	position: absolute;
	display: block;
	height: 8px;
	margin-bottom: -4px;
	background-color: transparent;
}

.handle-v:hover,
.handle-h:hover
{
	background-color: @olive;
}

.handle-v.hidden,
.handle-h.hidden
{
	display: none;
}

/* ============================================================ form cards */

.form-title
{
	display: block;
	margin: 0px 0px 10px 0px;
	padding: 0px;
	color: @dim;
	font-size: 13px;
	font-weight: bold;
}

/* ================================================================ welcome */

#welcome
{
	position: absolute;
	left: 0px;
	right: 0px;
	top: 30px;
	bottom: 22px;
	display: none;
	margin: 0px;
	background-color: @veil;
	z-index: 20;
}

#welcome.shown
{
	display: block;
}

#welcome-card
{
	position: absolute;
	left: 34%;
	right: 34%;
	top: 16%;
	display: block;
	margin: 0px;
	background-color: @card;
	border-width: 1px;
	border-color: @border-strong;
	border-radius: 6px;
	padding: 22px;
}

#welcome-title
{
	display: block;
	font-size: 32px;
	font-weight: bold;
	color: @gold;
}

#welcome-sub
{
	display: block;
	color: @dim;
	margin: 0px 0px 16px 0px;
	font-size: 13px;
}

#welcome-new
{
	margin-right: 8px;
	margin-bottom: 14px;
}

#welcome-load
{
	margin-bottom: 14px;
}

#recent-list
{
	display: block;
	height: 130px;
	margin: 0px;
	background-color: @bg-well;
	border-width: 1px;
	border-color: @border-faint;
	border-radius: 4px;
	padding: 4px;
}

/* ================================================================ modal */

#modal-new-project
{
	position: absolute;
	left: 0px;
	right: 0px;
	top: 28px;
	bottom: 22px;
	display: none;
	margin: 0px;
	background-color: @backdrop;
	z-index: 30;
}

#modal-new-project.shown
{
	display: block;
}

#np-card
{
	position: absolute;
	left: 30%;
	right: 30%;
	top: 22%;
	display: block;
	margin: 0px;
	background-color: @card;
	border-width: 1px;
	border-color: @border-strong;
	border-radius: 6px;
	padding: 18px;
}

.form-row
{
	display: block;
	margin: 0px 0px 8px 0px;
}

.form-label
{
	display: inline-block;
	width: 28%;
	margin: 0px;
	color: @dim;
}

.form-actions
{
	display: block;
	margin: 14px 0px 0px 0px;
	text-align: right;
}

#np-name,
#np-folder
{
	display: inline-block;
	width: 55%;
	margin: 0px;
}

#np-create
{
	margin-right: 8px;
}

/* ================================================================== list */

.scroll
{
	overflow: auto;
}

.mono
{
	font-family: "Hack";
	font-size: 12px;
}

/* Bare content rows must pin block layout explicitly: RmlUi elements
   default to inline, so unclassed divs would run together on one line. */
.line
{
	display: block;
	white-space: pre-wrap;
	word-break: break-word;
}

.list-head
{
	display: block;
	margin: 0px 0px 4px 0px;
	padding: 2px 6px;
	color: @dim;
	font-size: 11px;
	font-weight: bold;
}

.item
{
	display: block;
	box-sizing: border-box;
	margin: 0px;
	padding: 2px 6px 2px 4px;
	border-left-width: 2px;
	border-left-color: transparent;
	border-radius: 3px;
	cursor: pointer;
	color: @text;
}

.item:hover
{
	background-color: @gold-hover;
	border-left-color: @gold;
}

.item.even
{
	background-color: @zebra-even;
}

.item.odd
{
	background-color: transparent;
}

.item.selected
{
	background-color: @gold-selected;
	border-left-color: @gold;
	color: @bright;
}

.item.selected:hover
{
	background-color: @gold-selected-hover;
	border-left-color: @gold-light;
}

.item.drop-target
{
	background-color: @gold-target;
	border-width: 1px;
	border-color: @gold;
}

.item.static
{
	cursor: default;
}

.item.static:hover
{
	background-color: transparent;
	border-left-color: transparent;
}

.toggle
{
	display: inline-block;
	width: 12px;
	margin: 0px 2px 0px 0px;
	padding: 0px;
	color: @dim;
	cursor: pointer;
	text-align: center;
	font-size: 12px;
}

.toggle:hover
{
	color: @bright;
}

.toggle.leaf
{
	cursor: default;
	color: @faint;
}

.toggle.leaf:hover
{
	color: @faint;
}

.tlabel
{
	display: inline-block;
	margin: 0px;
	padding: 0px;
}

.eid
{
	display: inline-block;
	margin: 0px 0px 0px 6px;
	padding: 0px;
	color: @faint-alt;
	font-size: 11px;
}

.item.selected .eid
{
	color: @dim;
}

.section-title
{
	display: block;
	margin: 0px;
	padding: 0px;
	color: @dim;
	font-size: 12px;
}

.item.core-sing
{
	color: @gold;
}

.item.core-sing.selected
{
	color: @bright;
}

.dim
{
	color: @muted;
}

.empty-message
{
	display: block;
	padding: 10px 8px;
	color: @dim;
	font-size: 12px;
	text-align: center;
}

/* =============================================================== inspector */

.ent-title
{
	display: block;
	margin: 0px 0px 8px 0px;
	padding: 4px 6px;
	font-weight: bold;
	font-size: 14px;
	color: @text;
	background-color: @bg-row;
	border-bottom-width: 2px;
	border-bottom-color: @gold;
}

.ent-title .eid
{
	margin-left: 8px;
	font-size: 11px;
	font-weight: normal;
	color: @dim;
}

.comp
{
	display: block;
	margin: 0px 0px 8px 0px;
	background-color: @bg-card;
	border-width: 1px;
	border-color: @border;
	border-radius: 4px;
	padding: 8px;
}

.comp-name
{
	display: block;
	margin: 0px 0px 6px 0px;
	padding: 0px 0px 4px 0px;
	color: @gold;
	font-size: 12px;
	font-weight: bold;
	border-bottom-width: 1px;
	border-bottom-color: @border;
	cursor: pointer;
}

.comp-name:hover
{
	color: @gold-light;
}

.field
{
	display: block;
	margin: 0px;
	padding: 2px 0px;
}

.field-name
{
	display: inline-block;
	width: 40%;
	margin: 0px;
	padding: 1px 0px;
	color: @dim;
	font-size: 12px;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.field-value
{
	display: inline-block;
	width: 58%;
	margin: 0px;
	padding: 1px 0px;
	font-family: "Hack";
	font-size: 12px;
	color: @text;
}

.field input[type=text]
{
	display: inline-block;
	width: 58%;
	box-sizing: border-box;
	margin: 0px;
	padding: 1px 4px;
	background-color: @bg-input;
	border-width: 1px;
	border-color: @border-strong;
	border-radius: 3px;
	color: @text;
	font-family: "Hack";
	font-size: 12px;
}

.field input[type=text]:focus
{
	border-color: @olive-light;
}

.field-lanes
{
	display: inline-block;
	width: 58%;
	margin: 0px;
	padding: 0px;
	vertical-align: top;
}

.field-lanes input[type=text]
{
	margin-right: 1%;
}

.boolbtn
{
	min-width: 72px;
	padding: 1px 8px;
	font-size: 12px;
}

.comp-icon
{
	display: inline-block;
	width: 16px;
	height: 16px;
	margin: 0px 6px 0px 2px;
	padding: 0px;
	vertical-align: middle;
}

/* =============================================================== console */

.cmd
{
	color: @gold;
	font-weight: bold;
}

.lv-warn
{
	color: @amber;
}

.lv-error
{
	color: @red;
}

/* ============================================================== agent tab */

#agent-toolbar
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 4px;
	height: 30px;
	display: block;
	margin: 0px;
	padding: 2px 0px;
	overflow: auto;
}

#agent-toolbar .dim
{
	margin-right: 4px;
}

#agent-toolbar button
{
	margin-right: 4px;
	padding: 2px 8px;
	vertical-align: middle;
}

#agent-toolbar select
{
	margin-right: 8px;
	vertical-align: middle;
}

#agent-status
{
	display: inline-block;
	margin: 0px 8px 0px 4px;
	padding: 0px;
	font-size: 12px;
	vertical-align: middle;
}

.ag-ok
{
	color: @olive-light;
}

.ag-busy
{
	color: @gold;
}

.ag-off
{
	color: @faint;
}

#agent-messages
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 38px;
	bottom: 36px;
	display: block;
	margin: 0px;
	background-color: @bg-well;
	border-width: 1px;
	border-color: @border-faint;
	border-radius: 4px;
	padding: 4px 6px;
}

#agent-inputrow
{
	position: absolute;
	left: 6px;
	right: 6px;
	bottom: 6px;
	height: 26px;
	display: block;
	margin: 0px;
	padding: 0px;
}

#agent-input-wrap
{
	position: absolute;
	left: 0px;
	right: 80px;
	top: 0px;
	bottom: 0px;
	display: block;
	margin: 0px;
	padding: 0px;
}

#agent-input
{
	display: block;
	width: 100%;
	height: 100%;
	box-sizing: border-box;
}

#btn-agent-send
{
	position: absolute;
	right: 0px;
	top: 0px;
	width: 74px;
}

.amsg
{
	display: block;
	margin: 0px 0px 8px 0px;
	padding: 0px 0px 6px 0px;
	border-bottom-width: 1px;
	border-bottom-color: @border-faint;
}

.arole
{
	display: block;
	margin: 0px 0px 2px 0px;
	font-weight: bold;
	font-size: 12px;
}

.role-user
{
	color: @role-blue;
}

.role-assistant
{
	color: @role-green;
}

.role-system
{
	color: @role-yellow;
}

.abody
{
	display: block;
	margin: 0px 0px 0px 12px;
	padding: 0px;
}

.tout
{
	display: block;
	margin: 4px 0px 4px 12px;
	padding: 4px 6px;
	background-color: @bg-input;
	border-width: 1px;
	border-color: @border-strong;
	border-radius: 4px;
	font-family: "Hack";
	font-size: 12px;
}

.diff-del
{
	color: @red;
}

.diff-add
{
	color: @green-bright;
}

.tc-pending
{
	color: @muted;
}

.tc-running
{
	color: @gold;
}

.tc-completed
{
	color: @olive-light;
}

.tc-failed
{
	color: @red;
}

/* ================================================================ agent content */

.tcontent
{
	display: block;
	margin: 0px;
	padding: 0px;
}

.plan-done
{
	color: @faint;
}

.plan-active
{
	color: @gold;
}

/* ================================================================ selects */

select
{
	display: inline-block;
	box-sizing: border-box;
	margin: 0px;
	padding: 1px 4px;
	background-color: @bg-input;
	border-width: 1px;
	border-color: @border-strong;
	border-radius: 4px;
	color: @text;
	font-size: 12px;
}

/* =================================================== agent permission modal */

#modal-agent-permission
{
	position: absolute;
	left: 0px;
	right: 0px;
	top: 28px;
	bottom: 22px;
	display: none;
	margin: 0px;
	background-color: @backdrop;
	z-index: 30;
}

#modal-agent-permission.shown
{
	display: block;
}

#perm-card
{
	position: absolute;
	left: 32%;
	right: 32%;
	top: 30%;
	display: block;
	margin: 0px;
	background-color: @card;
	border-width: 1px;
	border-color: @border-strong;
	border-radius: 6px;
	padding: 18px;
}

#perm-card button
{
	margin-right: 6px;
	margin-bottom: 6px;
}

#perm-title
{
	display: block;
	max-height: 120px;
	margin: 0px 0px 8px 0px;
	padding: 6px 8px;
	background-color: @bg-well;
	border-width: 1px;
	border-color: @border-faint;
	border-radius: 4px;
	overflow: auto;
}
