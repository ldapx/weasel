/* Weasel editor (RmlUi) theme — matches the ImGui editor palette:
   olive primary #68763c, gold secondary #dec16b, near-black backgrounds
   #09090c / #0c0d12 / #101116, warm off-white text #f2ebe9.
   Layout stays absolute-positioned: every element participating in layout
   sets its display explicitly. */

body
{
	display: block;
	width: 100%;
	height: 100%;
	margin: 0px;
	padding: 0px;
	font-family: "Spline Sans";
	font-size: 13px;
	color: #f2ebe9;
}

/* ================================================================ scrollbars */

scrollbarvertical
{
	width: 5px;
}

scrollbarvertical slidertrack
{
	background-color: #09090c80;
}

scrollbarvertical sliderbar
{
	background-color: #2f3242;
	min-height: 12px;
	border-radius: 3px;
}

scrollbarvertical sliderbar:hover
{
	background-color: #68763c;
}

scrollbarhorizontal
{
	height: 5px;
}

scrollbarhorizontal slidertrack
{
	background-color: #09090c80;
}

scrollbarhorizontal sliderbar
{
	background-color: #2f3242;
	min-width: 12px;
	border-radius: 3px;
}

scrollbarhorizontal sliderbar:hover
{
	background-color: #68763c;
}

/* ================================================================ menu bar */

#menubar
{
	position: absolute;
	left: 0px;
	right: 0px;
	top: 0px;
	height: 30px;
	margin: 0px;
	background-color: #09090c;
	border-bottom-width: 1px;
	border-bottom-color: #2a2c38;
	z-index: 10;
}

.mb-item
{
	position: absolute;
	top: 0px;
	height: 30px;
	margin: 0px;
}

#mb-file { left: 4px; width: 52px; }
#mb-scene { left: 56px; width: 66px; }
#mb-window { left: 122px; width: 78px; }

.menubtn
{
	display: block;
	width: 100%;
	height: 28px;
	line-height: 28px;
	box-sizing: border-box;
	margin: 0px;
	padding: 0px 10px;
	text-align: left;
	background-color: transparent;
	border-width: 0px;
	color: #f2ebe9;
	font-size: 13px;
}

.menubtn:hover
{
	background-color: #262a37;
}

.menu
{
	position: absolute;
	left: 0px;
	top: 29px;
	width: 220px;
	display: none;
	margin: 0px;
	background-color: #101116;
	border-width: 1px;
	border-color: #2f3242;
	border-radius: 4px;
	padding: 4px 0px;
	z-index: 11;
}

.menu.shown
{
	display: block;
}

.menuitem
{
	display: block;
	margin: 0px;
	padding: 5px 12px;
	cursor: pointer;
	color: #f2ebe9;
}

.menuitem:hover
{
	background-color: #2b3040;
	color: #ffffff;
}

.menusep
{
	display: block;
	height: 1px;
	margin: 4px 8px;
	padding: 0px;
	background-color: #2a2c38;
}

/* =============================================================== status bar */

#statusbar
{
	position: absolute;
	left: 0px;
	right: 0px;
	bottom: 0px;
	height: 22px;
	margin: 0px;
	background-color: #09090c;
	border-top-width: 1px;
	border-top-color: #2a2c38;
	z-index: 5;
}

#status
{
	position: absolute;
	left: 12px;
	right: 12px;
	top: 4px;
	color: #9a938b;
	font-size: 12px;
	text-align: left;
}

.mode
{
	display: inline-block;
	margin: 0px;
	padding: 1px 8px;
	border-radius: 4px;
	font-weight: bold;
	font-size: 11px;
}

.mode-edit
{
	background-color: #68763c;
	color: #f2ebe9;
}

.mode-playing
{
	background-color: #dec16b;
	color: #09090c;
}

.mode-paused
{
	background-color: transparent;
	border-width: 1px;
	border-color: #dec16b;
	color: #dec16b;
}

.st-dim
{
	color: #9a938b;
}

.st-sep
{
	color: #4a4438;
	margin: 0px 6px;
}

/* ================================================================== panels */

.panel
{
	display: block;
	margin: 0px;
	padding: 0px;
	background-color: #0c0d12f7;
	border-width: 1px;
	border-color: #2a2c38;
}

#left
{
	position: absolute;
	left: 0px;
	top: 30px;
	width: 22%;
	bottom: 22px;
}

#right
{
	position: absolute;
	right: 0px;
	top: 30px;
	width: 25%;
	bottom: 22px;
}

#bottom
{
	position: absolute;
	left: 22%;
	right: 25%;
	bottom: 22px;
	height: 27%;
}

.panel.hidden,
#bottom.hidden
{
	display: none;
}

.panel-title
{
	position: absolute;
	left: 7px;
	top: 6px;
	display: block;
	margin: 0px;
	padding: 0px;
	color: #9a938b;
	font-size: 12px;
}

/* ================================================================ tabs */

.tabbar
{
	position: absolute;
	left: 0px;
	right: 0px;
	top: 0px;
	height: 28px;
	display: flex;
	margin: 0px;
	background-color: #101116;
	border-bottom-width: 1px;
	border-bottom-color: #2a2c38;
}

/* Tabs fill the whole tab-bar height: the visible strip is exactly the
   clickable/hoverable area. The active tab gets a gold underline. */
.tab
{
	display: inline-block;
	box-sizing: border-box;
	height: 28px;
	line-height: 17px;
	margin: 0px 1px 0px 0px;
	padding: 5px 14px 3px 14px;
	color: #9a938b;
	font-size: 12px;
	background-color: transparent;
	border-bottom-width: 2px;
	border-bottom-color: transparent;
	cursor: pointer;
}

.tab.active
{
	color: #f2ebe9;
	border-bottom-color: #dec16b;
}

/* Hover rules come after '.tab.active' on purpose: equal specificity means
   the later rule wins, so the active tab highlight reacts to the pointer too. */
.tab:hover
{
	color: #ffffff;
	background-color: #2c3242;
}

.tab.active:hover
{
	color: #ffffff;
	background-color: #2c3242;
}

.tabpage
{
	position: absolute;
	left: 0px;
	right: 0px;
	top: 29px;
	bottom: 0px;
	display: block;
	margin: 0px;
}

.tabpage.hidden
{
	display: none;
}

#hierarchy
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 4px;
	bottom: 38%;
	display: block;
	margin: 0px;
}

#singletons-title
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 62%;
	height: 20px;
	display: block;
	margin: 4px 0px 0px 0px;
	padding: 0px 6px;
	color: #9a938b;
	font-size: 12px;
	font-weight: bold;
}

#singletons
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 62%;
	bottom: 6px;
	display: block;
	margin: 26px 0px 0px 0px;
}

#inspector
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 4px;
	bottom: 6px;
	display: block;
	margin: 0px;
}

#files-toolbar
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 4px;
	height: 26px;
	display: block;
	margin: 0px;
	padding: 0px;
}

#files
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 34px;
	bottom: 6px;
	display: block;
	margin: 0px;
}

#build-actions
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 4px;
	display: block;
	margin: 0px;
	padding: 0px;
}

#build-actions button
{
	margin-right: 4px;
	margin-bottom: 4px;
}

#build-lists
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 62px;
	bottom: 6px;
	display: block;
	margin: 0px;
}

#systems
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 4px;
	bottom: 6px;
	display: block;
	margin: 0px;
}

#console-output
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 4px;
	bottom: 34px;
	display: block;
	margin: 0px;
	background-color: #06070ad9;
	border-width: 1px;
	border-color: #23252f;
	border-radius: 4px;
	padding: 4px 6px;
}

#console-input-wrap
{
	position: absolute;
	left: 6px;
	right: 6px;
	bottom: 6px;
	height: 24px;
	display: block;
	margin: 0px;
	padding: 0px;
}

#console-input
{
	display: block;
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	margin: 0px;
	background-color: #101218;
	border-width: 1px;
	border-color: #2f3242;
	border-radius: 4px;
	color: #f2ebe9;
	padding: 1px 6px;
	font-size: 13px;
}

#console-input:focus
{
	border-color: #8fa34f;
}

#log-filters
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 4px;
	height: 24px;
	display: block;
	margin: 0px;
	padding: 0px;
}

#log-filters button
{
	margin-right: 4px;
	padding: 2px 8px;
	vertical-align: middle;
}

.lvbtn
{
	min-width: 26px;
	text-align: center;
}

.lvbtn.active
{
	background-color: #68763c;
	border-color: #8fa34f;
	color: #f2ebe9;
	font-weight: bold;
}

.lvsep
{
	display: inline-block;
	width: 1px;
	height: 16px;
	margin: 0px 6px;
	padding: 0px;
	vertical-align: middle;
	background-color: #2a2c38;
}

#log-category
{
	display: inline-block;
	box-sizing: border-box;
	height: 22px;
	margin: 0px;
	padding: 1px 4px;
	vertical-align: middle;
	background-color: #101218;
	border-width: 1px;
	border-color: #2f3242;
	border-radius: 4px;
	color: #f2ebe9;
	font-size: 12px;
}

#log-output
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 34px;
	bottom: 6px;
	display: block;
	margin: 0px;
	background-color: #06070ad9;
	border-width: 1px;
	border-color: #23252f;
	border-radius: 4px;
	padding: 4px 6px;
}

/* ============================================================== game view */

#gameview-toolbar
{
	position: absolute;
	left: 22%;
	right: 25%;
	top: 30px;
	height: 36px;
	display: block;
	margin: 0px;
	padding-top: 5px;
	padding-right: 0px;
	padding-bottom: 0px;
	padding-left: 0px;
	text-align: center;
	background-color: #0c0d12f5;
	border-width: 1px;
	border-color: #2a2c38;
}

.tgroup
{
	display: inline-block;
	margin: 0px;
	padding: 0px;
	vertical-align: middle;
}

.tgroup button
{
	margin-right: 2px;
	margin-left: 2px;
}

.tsep
{
	display: inline-block;
	width: 1px;
	height: 18px;
	margin: 0px 8px;
	padding: 0px;
	vertical-align: middle;
	background-color: #2a2c38;
}

#gameview
{
	position: absolute;
	left: 22%;
	right: 25%;
	top: 66px;
	bottom: 27%;
	display: block;
	margin: 0px;
	border-width: 1px;
	border-color: #2a2c38;
}

/* ================================================================ buttons */

button
{
	display: inline-block;
	box-sizing: border-box;
	margin: 0px;
	padding: 4px 10px;
	background-color: #1b1d26;
	border-width: 1px;
	border-color: #2f3242;
	border-radius: 4px;
	color: #f2ebe9;
	font-size: 12px;
	cursor: pointer;
}

button:hover
{
	background-color: #262a37;
}

button.active
{
	background-color: #68763c;
	border-color: #8fa34f;
	color: #f2ebe9;
	font-weight: bold;
}

button:disabled
{
	opacity: 0.5;
	cursor: default;
}

.btn--primary
{
	background-color: #dec16b;
	border-color: #dec16b;
	color: #09090c;
	font-weight: bold;
}

.btn--primary:hover
{
	background-color: #e8d194;
	border-color: #e8d194;
}

.btn--secondary
{
	background-color: transparent;
	border-color: #2f3242;
	color: #f2ebe9;
}

.btn--secondary:hover
{
	background-color: #1b1d26;
}

.btn--success
{
	background-color: #68763c;
	border-color: #8fa34f;
	color: #f2ebe9;
	font-weight: bold;
}

.btn--error
{
	background-color: #7c3a3a;
	border-color: #a05050;
	color: #f2ebe9;
	font-weight: bold;
}

.gap
{
	display: inline-block;
	width: 14px;
	height: 1px;
}

/* =============================================================== inputs */

input
{
	display: inline-block;
	box-sizing: border-box;
	margin: 0px;
	padding: 2px 6px;
	background-color: #101218;
	border-width: 1px;
	border-color: #2f3242;
	border-radius: 4px;
	color: #f2ebe9;
	font-size: 13px;
}

input:focus
{
	border-color: #8fa34f;
}

/* ======================================================= resize handles */

.handle-v
{
	position: absolute;
	display: block;
	top: 30px;
	bottom: 22px;
	width: 8px;
	margin-left: -4px;
	background-color: transparent;
}

.handle-h
{
	position: absolute;
	display: block;
	height: 8px;
	margin-bottom: -4px;
	background-color: transparent;
}

.handle-v:hover,
.handle-h:hover
{
	background-color: #68763c;
}

.handle-v.hidden,
.handle-h.hidden
{
	display: none;
}

/* ============================================================ form cards */

.form-title
{
	display: block;
	margin: 0px 0px 10px 0px;
	padding: 0px;
	color: #9a938b;
	font-size: 13px;
	font-weight: bold;
}

/* ================================================================ welcome */

#welcome
{
	position: absolute;
	left: 0px;
	right: 0px;
	top: 30px;
	bottom: 22px;
	display: none;
	margin: 0px;
	background-color: #07080bf2;
	z-index: 20;
}

#welcome.shown
{
	display: block;
}

#welcome-card
{
	position: absolute;
	left: 34%;
	right: 34%;
	top: 16%;
	display: block;
	margin: 0px;
	background-color: rgb(14, 15, 20);
	border-width: 1px;
	border-color: #2f3242;
	border-radius: 6px;
	padding: 22px;
}

#welcome-title
{
	display: block;
	font-size: 32px;
	font-weight: bold;
	color: #dec16b;
}

#welcome-sub
{
	display: block;
	color: #9a938b;
	margin: 0px 0px 16px 0px;
	font-size: 13px;
}

#welcome-new
{
	margin-right: 8px;
	margin-bottom: 14px;
}

#welcome-load
{
	margin-bottom: 14px;
}

#recent-list
{
	display: block;
	height: 130px;
	margin: 0px;
	background-color: #06070ad9;
	border-width: 1px;
	border-color: #23252f;
	border-radius: 4px;
	padding: 4px;
}

/* ================================================================ modal */

#modal-new-project
{
	position: absolute;
	left: 0px;
	right: 0px;
	top: 28px;
	bottom: 22px;
	display: none;
	margin: 0px;
	background-color: #0000008c;
	z-index: 30;
}

#modal-new-project.shown
{
	display: block;
}

#np-card
{
	position: absolute;
	left: 30%;
	right: 30%;
	top: 22%;
	display: block;
	margin: 0px;
	background-color: rgb(14, 15, 20);
	border-width: 1px;
	border-color: #2f3242;
	border-radius: 6px;
	padding: 18px;
}

.form-row
{
	display: block;
	margin: 0px 0px 8px 0px;
}

.form-label
{
	display: inline-block;
	width: 28%;
	margin: 0px;
	color: #9a938b;
}

.form-actions
{
	display: block;
	margin: 14px 0px 0px 0px;
	text-align: right;
}

#np-name,
#np-folder
{
	display: inline-block;
	width: 55%;
	margin: 0px;
}

#np-create
{
	margin-right: 8px;
}

/* ================================================================== list */

.scroll
{
	overflow: auto;
}

.mono
{
	font-family: "Hack";
	font-size: 12px;
}

/* Bare content rows must pin block layout explicitly: RmlUi elements
   default to inline, so unclassed divs would run together on one line. */
.line
{
	display: block;
	white-space: pre-wrap;
	word-break: break-word;
}

.list-head
{
	display: block;
	margin: 0px 0px 4px 0px;
	padding: 2px 6px;
	color: #9a938b;
	font-size: 11px;
	font-weight: bold;
}

.item
{
	display: block;
	box-sizing: border-box;
	margin: 0px;
	padding: 2px 6px 2px 4px;
	border-left-width: 2px;
	border-left-color: transparent;
	border-radius: 3px;
	cursor: pointer;
	color: #f2ebe9;
}

.item:hover
{
	background-color: #dec16b1c;
	border-left-color: #dec16b;
}

.item.even
{
	background-color: #ffffff06;
}

.item.odd
{
	background-color: transparent;
}

.item.selected
{
	background-color: #dec16b40;
	border-left-color: #dec16b;
	color: #ffffff;
}

.item.selected:hover
{
	background-color: #dec16b59;
	border-left-color: #e8d194;
}

.item.drop-target
{
	background-color: #dec16b30;
	border-width: 1px;
	border-color: #dec16b;
}

.item.static
{
	cursor: default;
}

.item.static:hover
{
	background-color: transparent;
	border-left-color: transparent;
}

.toggle
{
	display: inline-block;
	width: 12px;
	margin: 0px 2px 0px 0px;
	padding: 0px;
	color: #9a938b;
	cursor: pointer;
	text-align: center;
	font-size: 12px;
}

.toggle:hover
{
	color: #ffffff;
}

.toggle.leaf
{
	cursor: default;
	color: #6b655a;
}

.toggle.leaf:hover
{
	color: #6b655a;
}

.tlabel
{
	display: inline-block;
	margin: 0px;
	padding: 0px;
}

.eid
{
	display: inline-block;
	margin: 0px 0px 0px 6px;
	padding: 0px;
	color: #6e6a63;
	font-size: 11px;
}

.item.selected .eid
{
	color: #9a938b;
}

.section-title
{
	display: block;
	margin: 0px;
	padding: 0px;
	color: #9a938b;
	font-size: 12px;
}

.item.core-sing
{
	color: #dec16b;
}

.item.core-sing.selected
{
	color: #ffffff;
}

.dim
{
	color: #8f8a80;
}

.empty-message
{
	display: block;
	padding: 10px 8px;
	color: #9a938b;
	font-size: 12px;
	text-align: center;
}

/* =============================================================== inspector */

.ent-title
{
	display: block;
	margin: 0px 0px 8px 0px;
	padding: 4px 6px;
	font-weight: bold;
	font-size: 14px;
	color: #f2ebe9;
	background-color: #1b1d26;
	border-bottom-width: 2px;
	border-bottom-color: #dec16b;
}

.ent-title .eid
{
	margin-left: 8px;
	font-size: 11px;
	font-weight: normal;
	color: #9a938b;
}

.comp
{
	display: block;
	margin: 0px 0px 8px 0px;
	background-color: #14161ee6;
	border-width: 1px;
	border-color: #2a2c38;
	border-radius: 4px;
	padding: 8px;
}

.comp-name
{
	display: block;
	margin: 0px 0px 6px 0px;
	padding: 0px 0px 4px 0px;
	color: #dec16b;
	font-size: 12px;
	font-weight: bold;
	border-bottom-width: 1px;
	border-bottom-color: #2a2c38;
	cursor: pointer;
}

.comp-name:hover
{
	color: #e8d194;
}

.field
{
	display: block;
	margin: 0px;
	padding: 2px 0px;
}

.field-name
{
	display: inline-block;
	width: 40%;
	margin: 0px;
	padding: 1px 0px;
	color: #9a938b;
	font-size: 12px;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.field-value
{
	display: inline-block;
	width: 58%;
	margin: 0px;
	padding: 1px 0px;
	font-family: "Hack";
	font-size: 12px;
	color: #f2ebe9;
}

.field input[type=text]
{
	display: inline-block;
	width: 58%;
	box-sizing: border-box;
	margin: 0px;
	padding: 1px 4px;
	background-color: #101218;
	border-width: 1px;
	border-color: #2f3242;
	border-radius: 3px;
	color: #f2ebe9;
	font-family: "Hack";
	font-size: 12px;
}

.field input[type=text]:focus
{
	border-color: #8fa34f;
}

.field-lanes
{
	display: inline-block;
	width: 58%;
	margin: 0px;
	padding: 0px;
	vertical-align: top;
}

.field-lanes input[type=text]
{
	margin-right: 1%;
}

.boolbtn
{
	min-width: 72px;
	padding: 1px 8px;
	font-size: 12px;
}

.comp-icon
{
	display: inline-block;
	width: 16px;
	height: 16px;
	margin: 0px 6px 0px 2px;
	padding: 0px;
	vertical-align: middle;
}

/* =============================================================== console */

.cmd
{
	color: #dec16b;
	font-weight: bold;
}

.lv-warn
{
	color: #f9e2af;
}

.lv-error
{
	color: #e06c60;
}

/* ============================================================== agent tab */

#agent-toolbar
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 4px;
	height: 30px;
	display: block;
	margin: 0px;
	padding: 2px 0px;
	overflow: auto;
}

#agent-toolbar .dim
{
	margin-right: 4px;
}

#agent-toolbar button
{
	margin-right: 4px;
	padding: 2px 8px;
	vertical-align: middle;
}

#agent-toolbar select
{
	margin-right: 8px;
	vertical-align: middle;
}

#agent-status
{
	display: inline-block;
	margin: 0px 8px 0px 4px;
	padding: 0px;
	font-size: 12px;
	vertical-align: middle;
}

.ag-ok
{
	color: #8fa34f;
}

.ag-busy
{
	color: #dec16b;
}

.ag-off
{
	color: #6b655a;
}

#agent-messages
{
	position: absolute;
	left: 6px;
	right: 6px;
	top: 38px;
	bottom: 36px;
	display: block;
	margin: 0px;
	background-color: #06070ad9;
	border-width: 1px;
	border-color: #23252f;
	border-radius: 4px;
	padding: 4px 6px;
}

#agent-inputrow
{
	position: absolute;
	left: 6px;
	right: 6px;
	bottom: 6px;
	height: 26px;
	display: block;
	margin: 0px;
	padding: 0px;
}

#agent-input-wrap
{
	position: absolute;
	left: 0px;
	right: 80px;
	top: 0px;
	bottom: 0px;
	display: block;
	margin: 0px;
	padding: 0px;
}

#agent-input
{
	display: block;
	width: 100%;
	height: 100%;
	box-sizing: border-box;
}

#btn-agent-send
{
	position: absolute;
	right: 0px;
	top: 0px;
	width: 74px;
}

.amsg
{
	display: block;
	margin: 0px 0px 8px 0px;
	padding: 0px 0px 6px 0px;
	border-bottom-width: 1px;
	border-bottom-color: #23252f;
}

.arole
{
	display: block;
	margin: 0px 0px 2px 0px;
	font-weight: bold;
	font-size: 12px;
}

.role-user
{
	color: #66b3ff;
}

.role-assistant
{
	color: #99e699;
}

.role-system
{
	color: #cccc66;
}

.abody
{
	display: block;
	margin: 0px 0px 0px 12px;
	padding: 0px;
}

.tout
{
	display: block;
	margin: 4px 0px 4px 12px;
	padding: 4px 6px;
	background-color: #101218;
	border-width: 1px;
	border-color: #2f3242;
	border-radius: 4px;
	font-family: "Hack";
	font-size: 12px;
}

.diff-del
{
	color: #e06c60;
}

.diff-add
{
	color: #a6e3a1;
}

.tc-pending
{
	color: #8f8a80;
}

.tc-running
{
	color: #dec16b;
}

.tc-completed
{
	color: #8fa34f;
}

.tc-failed
{
	color: #e06c60;
}

/* ================================================================ agent content */

.tcontent
{
	display: block;
	margin: 0px;
	padding: 0px;
}

.plan-done
{
	color: #6b655a;
}

.plan-active
{
	color: #dec16b;
}

/* ================================================================ selects */

select
{
	display: inline-block;
	box-sizing: border-box;
	margin: 0px;
	padding: 1px 4px;
	background-color: #101218;
	border-width: 1px;
	border-color: #2f3242;
	border-radius: 4px;
	color: #f2ebe9;
	font-size: 12px;
}

/* =================================================== agent permission modal */

#modal-agent-permission
{
	position: absolute;
	left: 0px;
	right: 0px;
	top: 28px;
	bottom: 22px;
	display: none;
	margin: 0px;
	background-color: #0000008c;
	z-index: 30;
}

#modal-agent-permission.shown
{
	display: block;
}

#perm-card
{
	position: absolute;
	left: 32%;
	right: 32%;
	top: 30%;
	display: block;
	margin: 0px;
	background-color: rgb(14, 15, 20);
	border-width: 1px;
	border-color: #2f3242;
	border-radius: 6px;
	padding: 18px;
}

#perm-card button
{
	margin-right: 6px;
	margin-bottom: 6px;
}

#perm-title
{
	display: block;
	max-height: 120px;
	margin: 0px 0px 8px 0px;
	padding: 6px 8px;
	background-color: #06070ad9;
	border-width: 1px;
	border-color: #23252f;
	border-radius: 4px;
	overflow: auto;
}
